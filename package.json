{
  "name": "serpex",
  "version": "2.10.3",
  "description": "Official TypeScript SDK for Serpex \u2014 real-time web search API and page content extraction for AI agents, LLM and RAG apps",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "serpex",
    "search",
    "search-api",
    "web-search",
    "real-time-search",
    "serp",
    "extract",
    "ai-agents",
    "llm",
    "rag",
    "typescript",
    "sdk"
  ],
  "author": "Serpex Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/divyeshradadiya/serpex-sdk-typescript",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/divyeshradadiya/serpex-sdk-typescript/issues"
  },
  "homepage": "https://github.com/divyeshradadiya/serpex-sdk-typescript#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.25",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ]
  }
}
